generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// USUARIOS Y ROLES
// ==============================
enum Rol {
  CLIENTE
  ADMINISTRADOR
  PROVEEDOR
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  telefono  String
  direccion String
  rol       Rol      @default(CLIENTE)
  creadoEn  DateTime @default(now())
  
  sesiones SesionActiva[]
  alquileres     Alquiler[]
  tallaRopa    String?
  tallaCalzado String?
  reservas     Reserva[]
  peticiones   PeticionDisfraz[]
  notificaciones Notificacion[]
}

// ==============================
// PRENDAS FÍSICAS Y DISFRACES
// ==============================
enum TipoPrenda {
  SOMBRERO
  CAMISA
  PANTALON
  FALDA
  ZAPATO
  ABRIGO
  CHALECO
  ACCESORIO
  PANUELO
  TACON
}

enum EstadoPrenda {
  DISPONIBLE
  DANADA
  FALTANTE
}

model DisfrazFisico {
  id                  String               @id @default(uuid())
  nombre              String
  familia             String?
  grupoCompatibilidad String?
  tipoDisfraz         String
  temporadaEvento     String
  precioAlquiler      Decimal              @db.Decimal(10, 2)
  estadoManual        EstadoManualDisfraz?
  fechaSuspension     DateTime?
  imagenUrl           String?
  origen              OrigenDisfraz        @default(CATALOGO)
  creadoEn            DateTime             @default(now())

  prendasHogar    Prenda[]          @relation("PrendaHogar")
  prendasActuales Prenda[]          @relation("PrendaActual")
  alquileres      AlquilerDisfraz[]
  reservas        Reserva[]

  @@index([grupoCompatibilidad])
  @@index([origen])
}

model Prenda {
  id              String       @id @default(uuid())
  nombre          String
  tipo            TipoPrenda
  color           String
  talla           String
  calidad         String       @default("bueno")
  estado          EstadoPrenda @default(DISPONIBLE)
  disfrazHogarId  String
  disfrazActualId String
  creadoEn        DateTime     @default(now())

  disfrazHogar  DisfrazFisico @relation("PrendaHogar", fields: [disfrazHogarId], references: [id])
  disfrazActual DisfrazFisico @relation("PrendaActual", fields: [disfrazActualId], references: [id])

  proveedores         PrendaProveedor[]
  devolucionItems     DevolucionPrenda[]
  movimientos MovimientoPrenda[]
  sustitucionesSalida Sustitucion[]

  @@index([disfrazHogarId])
  @@index([disfrazActualId])
}

// Auditoría de préstamos automáticos entre disfraces
model Sustitucion {
  id               String   @id @default(uuid())
  prendaId         String
  disfrazOrigenId  String   // el "hogar" de la prenda, de donde se prestó
  disfrazDestinoId String   // el disfraz que quedó completado con el préstamo
  motivo           String   // ej. "Pañuelo dañado en Marinera #1"
  fecha            DateTime @default(now())

  prenda Prenda @relation(fields: [prendaId], references: [id])
}

// ==============================
// PROVEEDORES
// ==============================
model Proveedor {
  id       String   @id @default(uuid())
  nombre   String
  contacto String
  telefono String?
  email    String?
  creadoEn DateTime @default(now())

  prendas PrendaProveedor[]
  ordenes OrdenReabastecimiento[]
}

model PrendaProveedor {
  id          String    @id @default(uuid())
  prendaId    String
  proveedorId String

  prenda    Prenda    @relation(fields: [prendaId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([prendaId, proveedorId])
}

enum EstadoOrden {
  SOLICITADA
  EN_CAMINO
  RECIBIDA
  CANCELADA
}

enum EstadoManualDisfraz {
  EN_REPARACION
  SUSPENDIDO
}

// Reabastecer ya no es "sumar stock a una pieza": es pedir prendas físicas
// NUEVAS de un tipo — por eso referencia tipoPrenda, no una Prenda puntual.
model OrdenReabastecimiento {
  id             String      @id @default(uuid())
  tipoPrenda     TipoPrenda
  proveedorId    String
  cantidad       Int
  estado         EstadoOrden @default(SOLICITADA)
  fechaSolicitud DateTime    @default(now())
  fechaEntrega   DateTime?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
}

// ==============================
// ALQUILERES
// ==============================
enum EstadoAlquiler {
  PENDIENTE
  ACTIVO
  FINALIZADO
  CANCELADO
}

model Alquiler {
  id              String         @id @default(uuid())
  usuarioId       String
  fechaInicio     DateTime
  fechaFin        DateTime
  evento          String?
  estado          EstadoAlquiler @default(ACTIVO)
  montoTotal      Decimal        @db.Decimal(10, 2)
  descuento        Decimal  @default(0) @db.Decimal(10, 2)
  detalleDescuento String?
  montoGarantia   Decimal        @default(0) @db.Decimal(10, 2)
  stripeSessionId String?        @unique
  creadoEn        DateTime       @default(now())

  usuario    Usuario           @relation(fields: [usuarioId], references: [id])
  disfraces  AlquilerDisfraz[]
  devolucion Devolucion?
  pago       Pago?
}

// Un alquiler puede incluir varios disfraces físicos (como hoy el carrito
// agrupa varios ítems en un solo alquiler).
model AlquilerDisfraz {
  id              String  @id @default(uuid())
  alquilerId      String
  disfrazFisicoId String
  precioUnitario  Decimal @db.Decimal(10, 2)

  alquiler      Alquiler      @relation(fields: [alquilerId], references: [id])
  disfrazFisico DisfrazFisico @relation(fields: [disfrazFisicoId], references: [id])
}

// ==============================
// DEVOLUCIONES
// ==============================
enum EstadoDevolucion {
  PENDIENTE
  APROBADA
  CON_OBSERVACIONES
  RECHAZADA
}

enum EstadoPrendaDevuelta {
  BUEN_ESTADO
  DANADA
  FALTANTE
}

model Devolucion {
  id              String           @id @default(uuid())
  alquilerId      String           @unique
  fechaDevolucion DateTime
  estado          EstadoDevolucion @default(PENDIENTE)
  penalidad       Decimal?         @db.Decimal(10, 2)
  observaciones   String?
  creadoEn        DateTime         @default(now())

  alquiler Alquiler           @relation(fields: [alquilerId], references: [id])
  prendas  DevolucionPrenda[]
}

// El cliente reporta el estado prenda por prenda (no todo el disfraz de una),
// porque es justo esa granularidad la que dispara (o no) una sustitución.
model DevolucionPrenda {
  id           String               @id @default(uuid())
  devolucionId String
  prendaId     String
  estadoPrenda EstadoPrendaDevuelta
  observacion  String?

  devolucion Devolucion @relation(fields: [devolucionId], references: [id])
  prenda     Prenda     @relation(fields: [prendaId], references: [id])
}

// ==============================
// PAGOS FICTICIOS
// ==============================
enum EstadoPago {
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

model Pago {
  id          String     @id @default(uuid())
  alquilerId  String     @unique
  monto       Decimal    @db.Decimal(10, 2)
  metodo      String     @default("TARJETA_SIMULADA")
  estado      EstadoPago
  comprobante String
  creadoEn    DateTime   @default(now())

  alquiler Alquiler @relation(fields: [alquilerId], references: [id])
}

// ==============================
// NOTIFICACIONES
// ==============================
model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String
  mensaje   String
  leido     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model SesionActiva {
  id        String   @id @default(uuid())
  usuarioId String
  tokenId   String   @unique
  creadoEn  DateTime @default(now())
  expiraEn  DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Promocion {
  id              String    @id @default(uuid())
  nombre          String
  descripcion     String
  porcentaje      Int
  codigo          String?   @unique
  minDias         Int?
  diasSemana      Int[]     @default([])
  tipoDisfraz     String?
  temporadaEvento String?
  vigenteDesde    DateTime?
  vigenteHasta    DateTime?
  activa          Boolean   @default(true)
  creadoEn        DateTime  @default(now())
}

enum OrigenDisfraz {
  CATALOGO
  ALMACEN
  A_MEDIDA
}

enum TipoReserva {
  A_MEDIDA
  AJUSTE_TALLA
}

model Receta {
  id            String   @id @default(uuid())
  nombre        String   @unique
  descripcion   String?
  palabrasClave String[] @default([])
  precioDia     Decimal  @db.Decimal(10, 2)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  piezas     RecetaPieza[]
  reservas   Reserva[]
  peticiones PeticionDisfraz[]
}

model RecetaPieza {
  id             String     @id @default(uuid())
  recetaId       String
  etiqueta       String
  tipo           TipoPrenda
  colores        String[]   @default([])
  nombreContiene String?
  obligatoria    Boolean    @default(true)

  receta Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([recetaId])
}

model Reserva {
  id              String      @id @default(uuid())
  tipo            TipoReserva
  usuarioId       String
  disfrazFisicoId String
  recetaId        String?
  peticion        String?
  tallaRopa       String?
  tallaCalzado    String?
  vence           DateTime
  confirmadaEn    DateTime?
  liberadaEn      DateTime?
  creadoEn        DateTime    @default(now())

  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  disfrazFisico DisfrazFisico      @relation(fields: [disfrazFisicoId], references: [id])
  receta        Receta?            @relation(fields: [recetaId], references: [id])
  movimientos   MovimientoPrenda[]

  @@index([disfrazFisicoId])
  @@index([usuarioId])
}

model MovimientoPrenda {
  id        String   @id @default(uuid())
  reservaId String
  prendaId  String
  desdeId   String
  haciaId   String
  orden     Int
  creadoEn  DateTime @default(now())

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  prenda  Prenda  @relation(fields: [prendaId], references: [id])

  @@index([reservaId])
  @@index([prendaId])
}

model PeticionDisfraz {
  id               String   @id @default(uuid())
  usuarioId        String
  texto            String
  textoNormalizado String
  recetaId         String?
  atendida         Boolean  @default(false)
  creadoEn         DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  receta  Receta? @relation(fields: [recetaId], references: [id])

  @@index([textoNormalizado])
}